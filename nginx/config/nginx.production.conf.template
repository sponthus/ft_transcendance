user  nginx;
worker_processes  auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;

    log_format  main    '$remote_addr [$time_local] "$request" '
                        'status:$status bytes-sent:$body_bytes_sent';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    server {
        listen 80;
		return 301 https://$host:4443$request_uri;
    }

    server {
        listen 443 ssl;
		listen [::]:443 ssl;

		client_max_body_size 5M;
        # ssl_certificate /etc/ssl/${DOMAIN_NAME}.crt;
        # ssl_certificate_key /etc/ssl/${DOMAIN_NAME}.key;
		ssl_certificate /run/secrets/ssl_cert.crt;
        ssl_certificate_key /run/secrets/ssl_key.key;

        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;

			location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?|glb|gltf|bin)$ {
			    add_header Cache-Control "public, max-age=31536000, immutable";
			    root /usr/share/nginx/html;
			    try_files $uri =404;
			}
        }

        location /uploads/ {
            root /app;
            try_files $uri /uploads/default.jpg;
        }

        location /api/ {
            proxy_pass https://api-gateway:${API_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;

            proxy_request_buffering off;
        }

        location /g-ws/ {
            proxy_pass https://game-service:${GAME_WS_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;

			proxy_request_buffering off;

			# Timeout pour les connexions longues
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location /s-ws/ {
            proxy_pass https://session-service:${SESSION_WS_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;

			proxy_request_buffering off;

			# Timeout pour les connexions longues
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }
    }
}