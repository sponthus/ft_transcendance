user  nginx;
worker_processes  auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main    '$remote_addr [$time_local] "$request" '
                        'status:$status bytes-sent:$body_bytes_sent';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    server {
        listen 80;
        server_name ${DOMAIN_NAME};

        location / {
        proxy_pass https://${DOMAIN_NAME}:4443$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name ${DOMAIN_NAME};

        ssl_certificate /etc/ssl/${DOMAIN_NAME}.crt;
        ssl_certificate_key /etc/ssl/${DOMAIN_NAME}.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        ssl_prefer_server_ciphers on;

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        location /uploads/ {
            root /app;
            try_files $uri /uploads/default.jpg;
        }

        location /api/ {
            proxy_pass http://api-gateway:${API_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;

            proxy_request_buffering off;
            client_max_body_size 10M;
        }

        location /g-ws/ {
            proxy_pass http://game-service:${GAME_WS_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
        }

        location /s-ws/ {
            proxy_pass http://session-service:${SESSION_WS_PORT};
            proxy_http_version 1.1;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
        }
    }
}